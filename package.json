{
  "name": "qa-checklist-tool",
  "version": "1.0.0",
  "private": true,
  "description": "ブラウザ完結型のQAチェックリスト生成ツール",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,yml,yaml,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,json,yml,yaml,html,css}\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  }
}
